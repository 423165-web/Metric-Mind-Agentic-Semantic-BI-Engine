# Copy this file to .env and fill in real credentials before running Cube.
NODE_ENV=development
CUBEJS_DEV_MODE=true
CUBEJS_DB_TYPE=snowflake
CUBEJS_DB_NAME=METRICMIND
CUBEJS_DB_SCHEMA=STAGING_MARTS
CUBEJS_DB_USER=your_snowflake_user
CUBEJS_DB_PASS=your_snowflake_password
CUBEJS_DB_ACCOUNT=your_snowflake_account
CUBEJS_DB_WAREHOUSE=COMPUTE_WH
CUBEJS_DB_ROLE=ACCOUNTADMIN
CUBEJS_DB_SNOWFLAKE_ACCOUNT=your_snowflake_account
CUBEJS_DB_SNOWFLAKE_WAREHOUSE=COMPUTE_WH
CUBEJS_DB_SNOWFLAKE_ROLE=ACCOUNTADMIN
CUBEJS_API_SECRET=replace_with_a_long_random_secret
CUBEJS_CACHE_AND_QUEUE_DRIVER=memory
